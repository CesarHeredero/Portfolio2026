# ── Entorno ───────────────────────────────────────────────────────────────────
APP_ENV=production
NODE_ENV=production

# ── Auth (Auth.js + Resend magic link) ───────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET=CAMBIA_ESTO_POR_UN_SECRET_ALEATORIO

# Resend — free tier 3.000 emails/mes https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
AUTH_EMAIL_FROM=hola@cesarheredero.com

# ── GitHub API (Git-as-CMS) ───────────────────────────────────────────────────
# Token con permisos: contents:write, metadata:read
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_OWNER=CesarHeredero
GITHUB_REPO=Portfolio2026
GITHUB_BRANCH=main

# ── Anthropic (IA para generar casos en el admin) ────────────────────────────
# Consíguelo en: https://console.anthropic.com → API Keys
# El plan gratuito incluye $5 de crédito inicial, suficiente para cientos de casos.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ── URL pública ───────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://cesarheredero.com
